{
  "name": "loto-gpt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green npm:dev:api npm:dev:web",
    "dev:api": "python backend/server.py --host 127.0.0.1 --port 8030",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "extract-content": "python scripts/extract_content.py",
    "train:lstm": "python backend/train_lstm.py --all",
    "test:backend": "python scripts/run_backend_tests.py",
    "loto649:update": "python scripts/loto649_pipeline.py update",
    "loto649:stats": "python scripts/loto649_pipeline.py statistics",
    "loto649:backtest": "python scripts/loto649_pipeline.py backtest",
    "loto649:train": "python scripts/loto649_pipeline.py train",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run dev"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^3.10.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "latest",
    "tailwindcss": "^4.3.3"
  }
}
